# ==========================================================
# NEURONUDGE ENVIRONMENT CONFIGURATION
# Copy this file to backend/root .env. Only NEXT_PUBLIC_* values belong in frontend/.env.local.
# ==========================================================

# ----------------------------------------------------------
# SUPABASE CONFIGURATION (Database, Auth, and Storage)
# ----------------------------------------------------------
# Find these in your Supabase Project Settings -> API & Database
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
SUPABASE_SECRET_KEY=
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Supabase PostgreSQL Connection String (Transaction Pooler or Direct)
# Example: postgresql+asyncpg://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/neuronudge
DATABASE_CA_CERT=backend/certs/supabase-ca.crt

# ----------------------------------------------------------
# AI & SPEECH SERVICES
# ----------------------------------------------------------
# OpenAI API Key (for GPT-4o Conversational 3D Buddy)
OPENAI_API_KEY=your_openai_api_key_here
OPENROUTER_KEY=
OPENROUTER_MODEL=openai/gpt-5.6-luna
OPENROUTER_CARE_REPORT_MODEL=anthropic/claude-opus-5.5
OPENROUTER_VISION_MODEL=openai/gpt-4o-mini
OPENROUTER_AUDIO_MODEL=google/gemini-3-flash-preview
# Optional local, revision-pinned phone hypotheses; never an automatic pronunciation score.
# Prepare with: python -m training.prepare_malayalam_phone_model --output artifacts/malayalam-xlsr-phone
MALAYALAM_PHONE_MODEL_DIR=
# Shared English/Hindi/Malayalam model; the older setting above remains a fallback.
PHONE_MODEL_DIR=
# Optional dedicated English/Hindi assessment. F0 basic assessment has a limited free quota.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
SARVAM_API_KEY=
SARVAM_ASR_MODEL=saaras:v4
DEEPGRAM_API_KEY=
DEEPGRAM_ASR_MODEL=nova-3
CARE_ASR_MODEL=large-v3
# Pre-cache actual model weights. Serving never downloads weights implicitly.
CARE_ASR_CACHE_DIR=

# ElevenLabs API Key & Voice ID (for low-latency streaming TTS)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ----------------------------------------------------------
# APPLICATION SERVICES
# ----------------------------------------------------------
# Backend API URL for frontend
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Redis Cache & Sessions (Optional)
REDIS_URL=redis://localhost:6379/0

# JWT Auth Secret (Used when running custom JWT fallback)
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Use supabase for hosted identities. Local auth requires a separate local DB.
AUTH_PROVIDER=supabase
APP_ENV=development
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-public-key

# Memgraph (local compose binds only to loopback)
MEMGRAPH_URI=bolt://127.0.0.1:7688
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=
# Production requires authenticated bolt+s:// with a trusted server certificate.
ALLOWED_ORIGINS=["https://your-deployment-host.example"]
ENABLE_LEGACY_RESEARCH_ROUTES=false
AUDIO_STORAGE_DIR=private-audio
# Generate 32 random bytes and encode as URL-safe base64; keep in your secret store.
AUDIO_ENCRYPTION_KEY=
ELEVENLABS_MODEL_ID=eleven_v3
ELEVENLABS_REGIONAL_MODEL_ID=eleven_v3
ELEVENLABS_AGENT_LLM=gpt-5.6-sol
ELEVENLABS_AGENT_TTS_MODEL=eleven_v3_conversational
LIVE_CALL_MAX_SECONDS=600

# Set true only after receiving written approval for this child-directed app.
ELEVENLABS_MINOR_APP_APPROVED=false

# Reference-conditioned Fish cloning through the existing OpenRouter account
VOICE_CLONING_PROVIDER=openrouter_fish
OPENROUTER_CLONE_MODEL=fish-audio/drama-3
# Optional local generated-speech mouth animation. Point to a deployed Rhubarb
# 1.14.0 executable; no learner audio is used for this animation.
RHUBARB_PATH=
